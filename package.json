{
  "name": "research-dashboard",
  "version": "1.0.0-rc.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:public-api": "node scripts/check-public-api.mjs",
    "check:public-api:live": "npm run build:academic-api-client && node --env-file=.env.local scripts/check-public-api.mjs --live",
    "generate:academic-api-client": "node packages/academic-api-client/scripts/generate-contract.mjs",
    "build:academic-api-client": "node packages/academic-api-client/scripts/generate-contract.mjs --check && tsc -p packages/academic-api-client/tsconfig.json",
    "test:academic-api-client": "npm run build:academic-api-client && node --test packages/academic-api-client/tests/*.test.mjs",
    "check:academic-api-client": "npm run test:academic-api-client",
    "build:backups-core": "tsc -p tsconfig.backups.json",
    "test:backups": "npm run build:backups-core && node --test tests/backups/*.test.mjs",
    "check:backups": "npm run test:backups"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
